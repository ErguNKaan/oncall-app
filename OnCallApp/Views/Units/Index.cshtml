@model IEnumerable<OnCallApp.ViewModels.UnitViewModel>
@{
    ViewData["Title"] = "Birimler";
}

<h1>Birimler Sayfası</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Yeni Birim Ekle</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Name)</th>
            <th>@Html.DisplayNameFor(model => model.WorkStartTime)</th>
            <th>@Html.DisplayNameFor(model => model.WorkEndTime)</th>
            <th>@Html.DisplayNameFor(model => model.HalfDayWorkEndTime)</th>
            <th>@Html.DisplayNameFor(model => model.IsActive)</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.Name)</td>
            <td>@Html.DisplayFor(modelItem => item.WorkStartTime)</td>
            <td>@Html.DisplayFor(modelItem => item.WorkEndTime)</td>
            <td>@Html.DisplayFor(modelItem => item.HalfDayWorkEndTime)</td>
            <td>@(item.IsActive ? "Evet" : "Hayır")</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Düzenle</a> 
                <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;">
                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Silmek/pasife almak istediğinize emin misiniz?');">Sil</button>
                </form>
            </td>
        </tr>
}
    </tbody>
</table>
