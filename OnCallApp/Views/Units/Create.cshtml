@model OnCallApp.ViewModels.UnitViewModel
@{
    ViewData["Title"] = "Yeni Birim";
}

<h1>Yeni Birim Ekle</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            
            <div class="mb-3">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="WorkStartTime" class="control-label"></label>
                <input asp-for="WorkStartTime" type="time" class="form-control" />
                <span asp-validation-for="WorkStartTime" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="WorkEndTime" class="control-label"></label>
                <input asp-for="WorkEndTime" type="time" class="form-control" />
                <span asp-validation-for="WorkEndTime" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="HalfDayWorkEndTime" class="control-label"></label>
                <input asp-for="HalfDayWorkEndTime" type="time" class="form-control" />
                <span asp-validation-for="HalfDayWorkEndTime" class="text-danger"></span>
            </div>
            <div class="mb-3 form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="IsActive" /> @Html.DisplayNameFor(model => model.IsActive)
                </label>
            </div>
            
            <div class="mb-3">
                <input type="submit" value="Oluştur" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Listeye Dön</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
